# Supabase API (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Prisma / Supabase Postgres (Project Settings > Database)
# Use the transaction pooler for the application and the direct connection for migrations.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
